{
  "$schema": "./constants.schema.json",
  "org": {
    "name": "practice-library",
    "repo": ".github",
    "defaultBranch": "main",
    "trustedAuthors": [
      "practice-library[bot]"
    ],
    "maintainer": "@practice-library/maintainers"
  },
  "runner": {
    "image": "ubuntu-24.04",
    "timeoutMinutes": 10
  },
  "actions": {
    "checkout": {
      "repo": "actions/checkout",
      "version": "v7.0.1",
      "sha": "3d3c42e5aac5ba805825da76410c181273ba90b1"
    },
    "allsGreen": {
      "repo": "re-actors/alls-green",
      "version": "v1.3.0",
      "sha": "b5b5b37504aa4183270bd3d855c52a67f212be35"
    }
  },
  "tools": {
    "gitleaks": {
      "version": "8.30.1",
      "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz",
      "sha256": "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb",
      "archive": "tar.gz",
      "bin": "gitleaks",
      "findingExitCode": 42
    },
    "jsonschema": {
      "version": "17.2.1",
      "url": "https://github.com/sourcemeta/jsonschema/releases/download/v17.2.1/jsonschema-17.2.1-linux-x86_64.zip",
      "sha256": "9ffee3cfbe0fe1343d9d36bcce9e6036ec4d73e4b29f656c039fca6118da2f35",
      "archive": "zip",
      "bin": "jsonschema-17.2.1-linux-x86_64/bin/jsonschema",
      "findingExitCode": 2
    }
  },
  "leakScan": {
    "config": ".gitleaks.toml",
    "defaultConfig": "[extend]\nuseDefault = true\n"
  },
  "checks": [
    {
      "id": "leak-scan",
      "workflow": "leak-scan.yml",
      "inputs": []
    },
    {
      "id": "schema-check",
      "workflow": "schema-check.yml",
      "inputs": [
        "schema",
        "instances"
      ],
      "targetFile": "check.json"
    }
  ],
  "selftest": {
    "fixturesDir": "selftest/fixtures",
    "caseFile": "case.json",
    "builder": "selftest/build.sh",
    "author": {
      "name": "selftest",
      "email": "selftest@example.invalid"
    },
    "unitDir": "selftest/unit",
    "libDir": "selftest/lib"
  },
  "self": {
    "discoverJob": "discover",
    "staticJobs": [
      "render",
      "discover",
      "unit"
    ],
    "discoverScript": "scripts/discover.sh",
    "unitScript": "scripts/unit.sh"
  },
  "render": {
    "script": "scripts/render.sh",
    "templatesDir": "templates",
    "fragmentsDir": "templates/fragments"
  },
  "gate": {
    "callerJob": "gate",
    "innerJob": "gate",
    "workflow": ".github/workflows/gate.yml",
    "callerWorkflow": ".github/workflows/self.yml",
    "actionsIntegrationId": 15368,
    "requiredJobs": [
      "leak-scan"
    ]
  },
  "automerge": {
    "mergeMethod": "merge",
    "allowPaths": [
      "ghgraph/graph/nodes/",
      "ghgraph/INDEX.md"
    ],
    "maxListedFiles": 3000
  },
  "ruleset": {
    "name": "default-branch",
    "enforcement": "active",
    "requiredApprovals": 0,
    "allowedMergeMethods": [
      "merge",
      "squash"
    ],
    "requireCodeOwnerReview": true,
    "strictStatusChecks": true,
    "dismissStaleReviews": true,
    "requireLastPushApproval": true
  },
  "dependabot": {
    "interval": "weekly",
    "openPullRequestsLimit": 5
  }
}

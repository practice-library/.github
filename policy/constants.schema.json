{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "constants.schema.json",
  "title": "Every limit, name, pin and URL the .github repository uses",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "org",
    "runner",
    "selfCheckout",
    "tooling",
    "actions",
    "tools",
    "leakScan",
    "checks",
    "selftest",
    "self",
    "render",
    "gate",
    "automerge",
    "ruleset",
    "dependabot",
    "canary",
    "spec",
    "tagRuleset",
    "release",
    "guards",
    "helpers"
  ],
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/][^\\s]*$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "version",
        "sha"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha": {
          "$ref": "#/$defs/sha1"
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "version",
        "url",
        "sha256",
        "archive",
        "bin",
        "findingExitCode",
        "expectInput"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive": {
          "enum": [
            "tar.gz",
            "zip"
          ]
        },
        "bin": {
          "$ref": "#/$defs/path"
        },
        "findingExitCode": {
          "type": "integer",
          "minimum": 1,
          "maximum": 125
        },
        "expectInput": {
          "type": "string",
          "pattern": "^_?[a-z][a-z0-9-]*$"
        }
      },
      "additionalProperties": false
    },
    "helper": {
      "type": "object",
      "required": [
        "version",
        "url",
        "sha256",
        "archive",
        "bin"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "archive": {
          "enum": [
            "tar.gz",
            "zip"
          ]
        },
        "bin": {
          "$ref": "#/$defs/path"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "org": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repo",
        "defaultBranch",
        "trustedAuthors",
        "maintainer",
        "appLogin"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        },
        "trustedAuthors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maintainer": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9-]+(/[A-Za-z0-9_.-]+)?$"
        },
        "appLogin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+\\[bot\\]$"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "timeoutMinutes",
        "unitTimeoutMinutes",
        "fetchRetries"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "unitTimeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "fetchRetries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selfCheckout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dir",
        "callerDir",
        "callerFetchDepth"
      ],
      "properties": {
        "dir": {
          "$ref": "#/$defs/path"
        },
        "callerDir": {
          "$ref": "#/$defs/path"
        },
        "callerFetchDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "launcher",
        "exitCodes",
        "lint"
      ],
      "properties": {
        "package": {
          "$ref": "#/$defs/path"
        },
        "launcher": {
          "$ref": "#/$defs/path"
        },
        "exitCodes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass",
            "fail",
            "error"
          ],
          "properties": {
            "pass": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "fail": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "error": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "lint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pythonRoots",
            "pythonExcludeDirs",
            "templateRoots",
            "templateSuffixes",
            "allowedNumbers",
            "policyKeywords",
            "policyCalls",
            "policyNames",
            "urlPattern",
            "textRules"
          ],
          "properties": {
            "pythonRoots": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "pythonExcludeDirs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "templateRoots": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/path"
              }
            },
            "templateSuffixes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^\\."
              }
            },
            "allowedNumbers": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "policyKeywords": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "policyCalls": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "call",
                  "positions"
                ],
                "properties": {
                  "call": {
                    "type": "string",
                    "minLength": 1
                  },
                  "positions": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "policyNames": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "urlPattern": {
              "type": "string",
              "minLength": 1
            },
            "textRules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "regex",
                  "why"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "regex": {
                    "type": "string",
                    "minLength": 1
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/action"
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/tool"
      }
    },
    "leakScan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "defaultConfig"
      ],
      "properties": {
        "config": {
          "$ref": "#/$defs/path"
        },
        "defaultConfig": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "workflow",
          "inputs",
          "tool"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "workflow": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.yml$"
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "targetFile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "optionalInputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "optionalPathInputs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      }
    },
    "selftest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixturesDir",
        "caseFile",
        "builder",
        "author",
        "unitDir",
        "libDir",
        "mutantsDir",
        "parseErrorPatterns"
      ],
      "properties": {
        "fixturesDir": {
          "$ref": "#/$defs/path"
        },
        "caseFile": {
          "type": "string",
          "minLength": 1
        },
        "builder": {
          "$ref": "#/$defs/path"
        },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "email"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "pattern": "@example\\.invalid$"
            }
          }
        },
        "unitDir": {
          "$ref": "#/$defs/path"
        },
        "libDir": {
          "$ref": "#/$defs/path"
        },
        "mutantsDir": {
          "$ref": "#/$defs/path"
        },
        "parseErrorPatterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "self": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discoverJob",
        "staticJobs",
        "discoverScript",
        "unitScript",
        "denylistCanary",
        "historyFiles",
        "releaseWatch",
        "sizeFixtures",
        "mutantsScript"
      ],
      "properties": {
        "discoverJob": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "staticJobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "discoverScript": {
          "$ref": "#/$defs/path"
        },
        "unitScript": {
          "$ref": "#/$defs/path"
        },
        "denylistCanary": {
          "$ref": "#/$defs/path"
        },
        "historyFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "releaseWatch": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "sizeFixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mutantsScript": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "templatesDir",
        "fragmentsDir",
        "renderedOnly"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/path"
        },
        "templatesDir": {
          "$ref": "#/$defs/path"
        },
        "fragmentsDir": {
          "$ref": "#/$defs/path"
        },
        "renderedOnly": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callerJob",
        "innerJob",
        "workflow",
        "callerWorkflow",
        "actionsIntegrationId",
        "mandatoryJobs",
        "requiredChecksFile"
      ],
      "properties": {
        "callerJob": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "innerJob": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "actionsIntegrationId": {
          "type": "integer",
          "minimum": 1
        },
        "workflow": {
          "$ref": "#/$defs/path"
        },
        "callerWorkflow": {
          "$ref": "#/$defs/path"
        },
        "mandatoryJobs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "requiredChecksFile": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "automerge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mergeMethod",
        "allowPaths",
        "maxListedFiles",
        "pathsFile"
      ],
      "properties": {
        "mergeMethod": {
          "enum": [
            "merge",
            "squash",
            "rebase"
          ]
        },
        "allowPaths": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "maxListedFiles": {
          "type": "integer",
          "minimum": 1
        },
        "pathsFile": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "enforcement",
        "requiredApprovals",
        "allowedMergeMethods",
        "requireCodeOwnerReview",
        "strictStatusChecks",
        "dismissStaleReviews",
        "requireLastPushApproval",
        "extraApprovalForUnattributedChanges"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "enum": [
            "active",
            "evaluate",
            "disabled"
          ]
        },
        "requiredApprovals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "allowedMergeMethods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "merge",
              "squash",
              "rebase"
            ]
          },
          "uniqueItems": true
        },
        "requireCodeOwnerReview": {
          "type": "boolean"
        },
        "strictStatusChecks": {
          "type": "boolean"
        },
        "dismissStaleReviews": {
          "type": "boolean"
        },
        "requireLastPushApproval": {
          "type": "boolean"
        },
        "extraApprovalForUnattributedChanges": {
          "type": "boolean"
        }
      }
    },
    "dependabot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "openPullRequestsLimit"
      ],
      "properties": {
        "interval": {
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ]
        },
        "openPullRequestsLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cron",
        "timeoutMinutes",
        "shards",
        "holdSeconds"
      ],
      "properties": {
        "cron": {
          "type": "string",
          "minLength": 9
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 360
        },
        "shards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "holdSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeSchemaId",
        "nodeSchemaPath"
      ],
      "properties": {
        "nodeSchemaId": {
          "type": "string",
          "pattern": "^https://"
        },
        "nodeSchemaPath": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "tagRuleset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "enforcement",
        "include"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enforcement": {
          "enum": [
            "active",
            "evaluate",
            "disabled"
          ]
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^refs/tags/"
          }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "ids",
        "denylistFile",
        "historyFiles",
        "releaseWatch",
        "changelog",
        "noReleaseMarker",
        "loosenLabel",
        "optional",
        "sizeLimit",
        "sizeFixtures",
        "sizeLabel",
        "tighteningPairs"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.yml$"
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "denylistFile": {
          "$ref": "#/$defs/path"
        },
        "historyFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "releaseWatch": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "changelog": {
          "$ref": "#/$defs/path"
        },
        "noReleaseMarker": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\n]+$"
        },
        "loosenLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true,
          "description": "Guards a caller may run that the gate does not require."
        },
        "sizeLimit": {
          "type": "integer",
          "minimum": 1
        },
        "sizeFixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sizeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "tighteningPairs": {
          "description": "Reviewed pattern changes that only tighten: each the SHA-256 of [old, new] as compact JSON, with why it accepts nothing new. schema-loosening does not flag a listed pair.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "why"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^'$]+$",
                "description": "Plain text: no ' or $, since it is rendered into a single-quoted YAML scalar that Actions also reads for expressions."
              }
            }
          }
        }
      }
    },
    "helpers": {
      "description": "Programs a workflow runs to do its job, not checks: fetched by URL and pinned by sha256 like tools (#@fetch), with no finding exit code or expect input.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/helper"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/practice-library/.github/spec/protocol/message.schema.json",
  "title": "Protocol v0 message",
  "description": "The one fenced json block of an issue that is a message between two repositories of the organisation. Top-level names follow CloudEvents 1.0 (specversion, id, source, type, time, datacontenttype, data); protocol is an extension attribute. See docs/protocol.md.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "protocol",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "specversion": {
      "const": "1.0",
      "description": "The CloudEvents version the field names follow."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$",
      "description": "The stable idempotency key: the sender looks for an open message with this id before creating one."
    },
    "source": {
      "type": "string",
      "pattern": "^https://github\\.com/practice-library/[A-Za-z0-9._-]+$",
      "description": "The sending repository."
    },
    "type": {
      "enum": [
        "org.practice-library.protocol.v0.request",
        "org.practice-library.protocol.v0.answer",
        "org.practice-library.protocol.v0.status",
        "org.practice-library.protocol.v0.blocked",
        "org.practice-library.protocol.v0.decision",
        "org.practice-library.protocol.v0.proposal"
      ],
      "description": "The kind of message."
    },
    "protocol": {
      "const": "0",
      "description": "The protocol version; a reader ignores a message of a version it does not know, with a warning."
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the message was written, UTC."
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "data": {
      "type": "object",
      "required": [
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^https://github\\.com/practice-library/[A-Za-z0-9._-]+$",
          "description": "The receiving repository."
        },
        "refs": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+#[1-9][0-9]{0,6}$"
          },
          "description": "Related issues and pull requests, as owner/repo#n."
        },
        "needs": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": "What the sender needs, one short line each."
        },
        "expires": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "org.practice-library.protocol.v0.blocked"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "needs"
            ],
            "properties": {
              "needs": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "org.practice-library.protocol.v0.decision"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "refs"
            ],
            "properties": {
              "refs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}

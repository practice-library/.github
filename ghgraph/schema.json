{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub fact node",
  "description": "One file under ghgraph/graph/nodes/, named <id>.json: the shared fact-node envelope, with this domain's type values.",
  "$ref": "https://github.com/practice-library/.github/spec/node/schema.json",
  "properties": {
    "type": {
      "enum": [
        "product",
        "plan",
        "limit",
        "rate-limit",
        "permission",
        "rule",
        "feature",
        "term"
      ]
    }
  }
}

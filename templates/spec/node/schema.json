{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "@@spec.nodeSchemaId@@",
  "title": "Fact node",
  "description": "The envelope every fact node shares: id, type, name, source URL, measuredAt, attrs (verdict, fetched_at, quote) and edges. A domain schema references this one and declares only its type values. That every edge target exists is checked by the graph checker, not by this schema.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "source",
    "measuredAt",
    "attrs",
    "edges"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "One of the type values the domain schema declares."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "source": {
      "$ref": "#/$defs/url",
      "description": "The official page the fact was read from; the quote is on this page."
    },
    "measuredAt": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "attrs": {
      "type": "object",
      "required": [
        "verdict",
        "fetched_at",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "enum": [
            "allowed",
            "denied",
            "limited",
            "unknown"
          ]
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "A short sentence copied exactly from the page."
        },
        "value": {
          "type": "number",
          "description": "A number only; its meaning is carried by unit, scope and window."
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Prose that does not fit value, unit, scope or window."
        }
      },
      "if": {
        "properties": {
          "verdict": {
            "const": "limited"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "scope"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "rel": {
            "enum": [
              "availableOn",
              "requires",
              "grantedBy",
              "limits",
              "appliesTo",
              "prohibitedBy",
              "supersedes",
              "hasRelease",
              "introducedIn",
              "removedIn"
            ]
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$"
          }
        }
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}

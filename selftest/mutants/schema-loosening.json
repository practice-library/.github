    "replace": "and ($refrev | not)"
  },
  {
    "name": "ref-position-ignored",
    "find": "and ($refrev | not) and ",
    "replace": "and "
  },
  {
    "name": "any-keyword-pair",
    "find": "pair: (if $k == \"pattern\" and ",
    "replace": "pair: (if "
  },
  {

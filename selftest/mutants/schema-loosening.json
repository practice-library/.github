  },
  {
    "name": "deleted-not-loose",
    "find": "if [ -z \"${NEW_FILE:-}\" ]; then echo 'loose [\"(deleted)\"]'; return 0; fi",
    "replace": ""
  },
  {
    "name": "schema-url-unanchored",
    "find": "test(\"^https?://json-schema",

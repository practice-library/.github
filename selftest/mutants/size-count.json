[
  {
    "name": "limit-exclusive",
    "find": "[ \"$n\" -le \"$LIMIT\" ]",
    "replace": "[ \"$n\" -lt \"$LIMIT\" ]"
  },
  {
    "name": "fixture-dir-prefix-only",
    "find": "((\"/\" + $p) | contains(\"/\" + $e))",
    "replace": "($p | startswith($e))"
  },
  {
    "name": "fixture-dir-substring",
    "find": "((\"/\" + $p) | contains(\"/\" + $e))",
    "replace": "($p | contains($e))"
  },
  {
    "name": "fixture-name-substring",
    "find": "($p | split(\"/\") | last) == $e",
    "replace": "($p | contains($e))"
  },
  {
    "name": "rename-old-path",
    "find": "\"\\(.b)\")",
    "replace": "\"\\(.a)\")"
  },
  {
    "name": "binary-counts",
    "find": "if .[0] == \"-\" then 0 else",
    "replace": "if .[0] == \"-\" then 9999 else"
  },
  {
    "name": "deleted-lines-count",
    "find": "{added: (if",
    "replace": "{added: ((.[1]|tonumber? // 0) + (if"
  },
  {
    "name": "fixtures-ignored",
    "find": "| select(fixture(.path) | not)",
    "replace": ""
  },
  {
    "name": "limit-check-off",
    "find": "[[ \"${LIMIT:-}\" =~ ^[0-9]+$ ]] ||",
    "replace": "true ||"
  },
  {
    "name": "numstat-check-off",
    "find": "if length < 3 or (.[0] | test(\"^([0-9]+|-)$\") | not) then error(\"bad numstat line: \" + join(\"\\t\")) else . end",
    "replace": "."
  },
  {
    "name": "leading-slash-kept",
    "find": "$p == ($e | ltrimstr(\"/\"))",
    "replace": "$p == $e"
  },
  {
    "name": "root-dir-anywhere",
    "find": "($p | startswith($e | ltrimstr(\"/\")))",
    "replace": "((\"/\" + $p) | contains($e))"
  },
  {
    "name": "binary-not-recounted",
    "find": "    NUMSTAT=\"$recount\"\n",
    "replace": "\n"
  },
  {
    "name": "slash-entry-allowed",
    "find": " and . != \"/\")",
    "replace": ")"
  },
  {
    "name": "header-plus-counted",
    "find": "f && /^\\+/ { n++ }",
    "replace": "/^\\+/ { n++ }"
  },
  {
    "name": "text-flag-dropped",
    "find": "added=\"$(git --literal-pathspecs diff --text --no-textconv",
    "replace": "added=\"$(git --literal-pathspecs diff --no-textconv"
  },
  {
    "name": "pathspec-as-glob",
    "find": "git --literal-pathspecs diff --text",
    "replace": "git diff --text"
  },
  {
    "name": "git-paths-rewritten",
    "find": "if $plain then . else newpath end",
    "replace": "newpath"
  },
  {
    "name": "rename-paths-swapped",
    "find": "IFS= read -r -d '' old; IFS= read -r -d '' path",
    "replace": "IFS= read -r -d '' path; IFS= read -r -d '' old"
  }
]

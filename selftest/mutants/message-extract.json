{
  "target": "tooling/practice_ci/protocol.py",
  "unit": "message-extract",
  "mutants": [
    {
      "name": "two-blocks-take-first",
      "find": "    if len(blocks) > 1:\n        return \"invalid",
      "replace": "    if False:\n        return \"invalid"
    },
    {
      "name": "unclosed-accepted",
      "find": "    if cur is not None:\n        return \"invalid",
      "replace": "    if False:\n        return \"invalid"
    },
    {
      "name": "control-allowed",
      "find": "    if has_unsafe(value):\n        return",
      "replace": "    if False:\n        return"
    },
    {
      "name": "unsafe-category-dropped",
      "find": "unicodedata.category(ch) in config.get(\"protocol\", \"unsafeCategories\") or",
      "replace": "False or"
    },
    {
      "name": "lone-surrogate-allowed",
      "find": " or \"\\ud800\" <= ch <= \"\\udfff\"",
      "replace": ""
    },
    {
      "name": "unsafe-key-allowed",
      "find": "            if any(_unsafe_string(key) for key in item):\n                return True\n",
      "replace": ""
    },
    {
      "name": "unsafe-nested-list-skipped",
      "find": "            pending.extend(item)\n",
      "replace": "            pass\n"
    },
    {
      "name": "unsafe-nested-object-skipped",
      "find": "            pending.extend(item.values())",
      "replace": "            pass"
    },
    {
      "name": "size-unlimited",
      "find": "    if len(body) > limit:",
      "replace": "    if False:"
    },
    {
      "name": "size-off-by-one",
      "find": "    if len(body) > limit:",
      "replace": "    if len(body) >= limit:"
    },
    {
      "name": "not-utf8-accepted",
      "find": "body.decode(\"utf-8\")",
      "replace": "body.decode(\"utf-8\", \"replace\")"
    },
    {
      "name": "array-accepted",
      "find": "    if not isinstance(value, dict):\n        return None, \"the block is not one JSON object\"\n    return value, None",
      "replace": "    return value, None"
    },
    {
      "name": "dup-keys-allowed",
      "find": "object_pairs_hook=_pairs, ",
      "replace": ""
    },
    {
      "name": "seen-not-recorded",
      "find": "        seen.add(key)\n",
      "replace": "        pass\n"
    },
    {
      "name": "constants-accepted",
      "find": ", parse_constant=_refuse_constant",
      "replace": ""
    },
    {
      "name": "fence-suffix-accepted",
      "find": "re.escape(config.get(\"protocol\", \"fenceOpen\")) + r\"[ \\t]*\"",
      "replace": "re.escape(config.get(\"protocol\", \"fenceOpen\"))"
    },
    {
      "name": "json-fence-any-length",
      "find": "            if re.fullmatch(r\"[ \\t]*\" + re.escape(info) + r\"[ \\t]*\", m[\"info\"]):\n                bad = True\n",
      "replace": ""
    },
    {
      "name": "other-fences-ignored",
      "find": "        elif _OTHER_FENCE.fullmatch(line):",
      "replace": "        elif False:"
    },
    {
      "name": "crlf-kept",
      "find": "text.replace(\"\\r\\n\", \"\\n\").split",
      "replace": "text.split"
    },
    {
      "name": "short-close-accepted",
      "find": "\"{\" + str(len(m[\"f\"])) + \",}\"",
      "replace": "\"{3,}\""
    },
    {
      "name": "exact-close-only",
      "find": "`{3,}[ \\t]*$\")\n_HTML",
      "replace": "```[ \\t]*$\")\n_HTML"
    },
    {
      "name": "html-comment-allowed",
      "find": "        elif _COMMENT_OPEN in line:",
      "replace": "        elif False:"
    },
    {
      "name": "html-block-allowed",
      "find": "        elif _HTML_BLOCK.match(line):",
      "replace": "        elif False:"
    },
    {
      "name": "backtick-info-allowed",
      "find": "(?P<f>`{3,}[^`]*|~{3,}.*)$\")\n_FENCE",
      "replace": "(?P<f>`{3,}.*|~{3,}.*)$\")\n_FENCE"
    },
    {
      "name": "other-close-unindented",
      "find": "re.fullmatch(r\" {0,3}\" + other + r\"[ \\t]*\", line)",
      "replace": "re.fullmatch(other + r\"[ \\t]*\", line)"
    },
    {
      "name": "multiline-needs-allowed",
      "find": "    if needs_multiline(value):\n        return",
      "replace": "    if False:\n        return"
    },
    {
      "name": "no-block-is-ok",
      "find": "    if not blocks:\n        return \"none\"",
      "replace": "    if False:\n        return \"none\""
    }
  ]
}

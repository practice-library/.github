[
  {
    "name": "two-blocks-take-first",
    "find": "elif (.blocks | length) > 1 then",
    "replace": "elif false then"
  },
  {
    "name": "unclosed-accepted",
    "find": "elif .cur != null then \"invalid a ```json block is not closed\"",
    "replace": "elif false then \"invalid\""
  },
  {
    "name": "control-allowed",
    "find": "elif (.blocks[0] | test(\"[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]\")) then",
    "replace": "elif false then"
  },
  {
    "name": "bidi-allowed",
    "find": "elif (.blocks[0] | test(\"[\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]\")) then",
    "replace": "elif false then"
  },
  {
    "name": "size-unlimited",
    "find": "[ \"$size\" -le 65536 ]",
    "replace": "true"
  },
  {
    "name": "size-off-by-one",
    "find": "[ \"$size\" -le 65536 ]",
    "replace": "[ \"$size\" -lt 65536 ]"
  },
  {
    "name": "array-accepted",
    "find": "jq -se 'length == 1 and (.[0] | type) == \"object\"'",
    "replace": "jq -se 'length == 1'"
  },
  {
    "name": "fence-suffix-accepted",
    "find": "test(\"^```json[ \\t]*$\")",
    "replace": "test(\"^```json\")"
  },
  {
    "name": "several-values-accepted",
    "find": "jq -se 'length == 1 and (.[0] | type) == \"object\"'",
    "replace": "jq -se '(.[0] | type) == \"object\"'"
  },
  {
    "name": "short-close-accepted",
    "find": "\"\\($c){\\($m.f | length),}\"",
    "replace": "\"\\($c){3,}\""
  },
  {
    "name": "json-fence-any-length",
    "find": "| (if ($m.info | test(\"^[ \\t]*json[ \\t]*$\")) then .bad = true else . end)",
    "replace": ""
  },
  {
    "name": "crlf-kept",
    "find": "gsub(\"\\r\\n\"; \"\\n\") | split",
    "replace": "split"
  },
  {
    "name": "dup-keys-allowed",
    "find": "twice) echo \"invalid a key is given twice in the block\"; return 0 ;;",
    "replace": "twice) ;;"
  },
  {
    "name": "seen-not-recorded",
    "find": "        seen.add(k)\n",
    "replace": "        pass\n"
  },
  {
    "name": "other-fences-ignored",
    "find": "elif ($l | test(\"^ {0,3}(`{3,}[^`]*|~{3,}.*)$\")) then",
    "replace": "elif false then"
  },
  {
    "name": "exact-close-only",
    "find": "(if ($l | test(\"^ {0,3}```+[ \\t]*$\"))",
    "replace": "(if ($l | test(\"^ {0,3}```[ \\t]*$\"))"
  },
  {
    "name": "backtick-info-allowed",
    "find": "(`{3,}[^`]*|~{3,}.*)",
    "replace": "(`{3,}.*|~{3,}.*)"
  },
  {
    "name": "other-close-unindented",
    "find": "test(\"^ {0,3}\" + $o + \"[ \\t]*$\")",
    "replace": "test(\"^\" + $o + \"[ \\t]*$\")"
  },
  {
    "name": "other-open-unindented",
    "find": "elif ($l | test(\"^ {0,3}(`{3,}",
    "replace": "elif ($l | test(\"^(`{3,}"
  },
  {
    "name": "json-close-unindented",
    "find": "(if ($l | test(\"^ {0,3}```+[ \\t]*$\"))",
    "replace": "(if ($l | test(\"^```+[ \\t]*$\"))"
  }
]

[
  {
    "name": "short-sha-accepted",
    "find": "test(\"^[0-9a-f]{40}$\")",
    "replace": "test(\"^[0-9a-f]{39,}$\")"
  },
  {
    "name": "upper-hex-accepted",
    "find": "test(\"^[0-9a-f]{40}$\")",
    "replace": "test(\"^[0-9a-fA-F]{40}$\")"
  },
  {
    "name": "owner-case-sensitive",
    "find": "split(\"/\")[0] | ascii_downcase)",
    "replace": "split(\"/\")[0])"
  },
  {
    "name": "spaces-kept",
    "find": "tostring | gsub(\"^\\\\s+|\\\\s+$\"; \"\")",
    "replace": "tostring"
  },
  {
    "name": "yaml-extension-skipped",
    "find": "\"$dir\"/*.yml \"$dir\"/*.yaml",
    "replace": "\"$dir\"/*.yml"
  },
  {
    "name": "no-ref-accepted",
    "find": "else \"(none)\" end",
    "replace": "else \"0123456789abcdef0123456789abcdef01234567\" end"
  },
  {
    "name": "empty-org-accepted",
    "find": "[ -n \"${ORG:-}\" ] || { echo \"invalid ORG is empty\"; return 0; }",
    "replace": "true"
  },
  {
    "name": "steps-unread",
    "find": ", (.value.steps // [] | .[] | .uses | select(. != null))",
    "replace": ""
  },
  {
    "name": "job-uses-unread",
    "find": "((.value.uses | select(. != null)), ",
    "replace": "(("
  },
  {
    "name": "parse-error-ignored",
    "find": "|| { echo \"invalid ${f#\"${ROOT:-.}/\"} is not YAML\"; return 0; }",
    "replace": "|| true"
  },
  {
    "name": "missing-yq-ignored",
    "find": "command -v \"$yq\" > /dev/null 2>&1 || { echo \"invalid no yq to read the workflows\"; return 0; }",
    "replace": "true"
  },
  {
    "name": "documents-not-merged",
    "find": "(add // []) | .[]",
    "replace": "(.[0] // []) | .[]"
  },
  {
    "name": "files-not-accumulated",
    "find": "found=\"$found$one\"",
    "replace": "found=\"$one\""
  },
  {
    "name": "other-owner-judged",
    "find": "select($owner == $org and",
    "replace": "select(("
  }
]

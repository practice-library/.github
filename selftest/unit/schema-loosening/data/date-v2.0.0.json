{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "measuredAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "verdict": {
      "enum": [
        "allowed",
        "denied"
      ]
    },
    "fetched_at": {
      "type": "string",
      "pattern": "Z$"
    }
  }
}
